{
  "expo": {
    "name": "worksite-diary",
    "slug": "worksite-diary",
    "owner": "plos-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "worksitediary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "xyz.plos.worksitediary",
      "supportsTablet": false
    },
    "android": {
      "package": "xyz.plos.worksitediary",
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Worksite Diary to access your photos so you can attach site photos to entries.",
          "cameraPermission": "Allow Worksite Diary to access your camera so you can take site photos for entries."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Worksite Diary to access your location so you can log the site's GPS coordinates on an entry."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83c2eaee-7615-4e6e-b00e-72b641d38063"
      }
    }
  }
}
